{
    "alembic": {
        "blurb": [
            "ПЕРЕГОННЫЙ КУБ позволяет алхимику",
            "извлечь и смешать две жидкости,",
            "обычно получая новый эффект.",
            "",
            "Умелые зельевары готовят в нём",
            "более сильные составы."
        ]
    },
    "arbalest": {
        "blurb": [
            "Тяжёлый арбалет — особая разновидность.",
            "Схож с обычным, но перезаряжается",
            "медленно, бьёт недалеко и обладает",
            "огромной отдачей.",
            "",
            "Достойная плата за такую мощь."
        ]
    },
    "axes": {
        "blurb": [
            "ТОПОРЫ не отличаются изяществом,",
            "зато от их ударов у врага",
            "захватывает дух.",
            "Отличны против лёгкой брони,",
            "но тяжёлое лезвие вгрызается",
            "даже в крепчайшие доспехи."
        ]
    },
    "backpacks": {
        "blurb": [
            "Бывалые искатели не советуют",
            "копить вещи: смерть быстро",
            "догоняет неповоротливых.",
            "",
            "Но иные мастера уверяют, что",
            "без вместительного РЮКЗАКА им никак."
        ]
    },
    "beartrap": {
        "blurb": [
            "Жестокое и грубоватое устройство:",
            "капкан смыкается на ногах врага",
            "и больно впивается зубьями.",
            "Большинство жертв остаются в путах",
            "и беззащитны перед ударами,",
            "пока челюсти не разожмутся."
        ]
    },
    "blood vials": {
        "blurb": [
            "При должной сноровке КРОВЬ можно",
            "забрать у жертвы прежде, чем",
            "её испачкает грязный пол подземелья.",
            "",
            "Лишь проклятые и отверженные",
            "найдут ей применение."
        ]
    },
    "boomerang": {
        "blurb": [
            "Говорят, одно племя делает",
            "оружие, которое после броска",
            " всегда возвращается к владельцу.",
            "Изношенный бумеранг дарят первенцу.",
            "Кто сумеет восстановить БУМЕРАНГ,",
            "тот и докажет свою доблесть."
        ]
    },
    "booze": {
        "blurb": [
            "Крепкая выпивка поднимает дух",
            "и придаёт силы и уверенности.",
            "Но вслед за ней — неточный прицел,",
            "тупость и слабый желудок.",
            "Решайте сами: выпивка —",
            "порок или удовольствие?"
        ]
    },
    "bows": {
        "blurb": [
            "Любимые стрелками и проходимцами,",
            "луки всех видов позволяют издали",
            "убивать врагов и досаждать им.",
            "",
            "Опытные охотники и разбойники",
            "держат наготове особые боеприпасы."
        ]
    },
    "chakrams and shurikens": {
        "blurb": [
            "Из хорошего материала можно сделать",
            "острые лезвия; вращаясь, такое оружие",
            "рикошетит от стен.",
            "Хитрые искатели поражают врагов",
            "даже из-за угла!",
            "Мечта метателя."
        ]
    },
    "cheese and apples": {
        "blurb": [
            "Простые КУСОЧКИ обычной еды.",
            "Чтобы насытиться, голодному искателю",
            "придётся съесть несколько.",
            "На испорченную еду решится разве что",
            "отчаянно голодный или тот, кто",
            "не слишком разборчив во вкусах."
        ]
    },
    "cloaks & clothing": {
        "blurb": [
            "Обычная ОДЕЖДА уступает доспехам,",
            "когда дело доходит до драки.",
            "",
            "Но зачарованные наряды порой",
            "убеждают искателей одеться полегче",
            "ради иных полезных свойств."
        ]
    },
    "cream pie": {
        "blurb": [
            "Деликатес подземелий. Порой начинка",
            "летит прямо в лицо голодному искателю",
            "и ненадолго лишает его зрения.",
            "",
            "А если есть не хочется, ПИРОГОМ",
            "можно сбить врага с толку ударом в лицо."
        ]
    },
    "crossbow": {
        "blurb": [
            "Механизм арбалета позволяет",
            "быстро перезарядить его и выстрелить",
            "одним нажатием спуска.",
            "Он уступает лукам в дальности,",
            "но всё так же способен стрелять",
            "особыми боеприпасами."
        ]
    },
    "crowns & headdresses": {
        "blurb": [
            "Редкие украшения для тех, кто близок",
            "к власти или к тайнам магии.",
            "",
            "Пусть они кажутся лишь символами,",
            "но могущественный символ",
            "способен на многое."
        ]
    },
    "crystal ammo": {
        "blurb": [
            "Если нужны самые острые",
            "и смертоносные зазубренные",
            "наконечники против любых врагов,",
            "лучше КРИСТАЛЬНЫХ СТРЕЛ не найти.",
            "",
            "Простой и превосходный снаряд."
        ]
    },
    "crystal armor": {
        "blurb": [
            "Обычно редкий КРИСТАЛЛ не пустили бы",
            "на доспехи — особенно с учётом",
            "его хрупкости.",
            "",
            "Лишь неимоверное изобилие волшебных",
            "кристаллов оправдает такую роскошь."
        ]
    },
    "crystal shard": {
        "blurb": [
            "ОСКОЛКИ КРИСТАЛЛА тусклее факелов,",
            "зато их свет виден лишь владельцу",
            "и никогда не гаснет.",
            "",
            "Однако осколки хрупки: при защите",
            "они быстро разлетаются на кусочки."
        ]
    },
    "death box": {
        "blurb": [
            "Ящик со всем мирским скарбом",
            "погибшего искателя приключений.",
            "",
            "Замедляет несущего его на 25%.",
            "Стоит разбить ящик, и всё содержимое",
            "немедленно высыплется наружу."
        ]
    },
    "defensive potions": {
        "blurb": [
            "ЗАЩИТНЫЕ ЗЕЛЬЯ обычно приносят",
            "выпившему полезный эффект.",
            "",
            "Союзнику нужна помощь? Запустите",
            "полезной бутылкой ему в лицо!"
        ]
    },
    "djinnis brace": {
        "blurb": [
            "Однажды путник нашёл лампу желаний,",
            "в которой сидел разъярённый джинн.",
            "",
            "Путник хотел освободить его,",
            "но оковы были неуязвимы.",
            "Лишь желание могло дать ему свободу."
        ]
    },
    "dragons mail": {
        "blurb": [
            "Легенда гласит, что дракон соперничал",
            "со странником из древних мифов.",
            "В погоне за славой они подружились.",
            "",
            "Перед смертью дракон завещал",
            "свою чешую страннику."
        ]
    },
    "dummybot": {
        "blurb": [
            "БОТОВ-МАНЕКЕНОВ создали как прочных",
            "переносных партнёров для тренировок.",
            "Позднее их зачаровали: теперь они",
            "дразнят врагов и удерживают внимание.",
            "Пока враг отвлечён, искатель может",
            "обойти его с меньшим риском."
        ]
    },
    "dyrnwyn": {
        "blurb": [
            "Говорят, этот меч служил знатным",
            "героям с благородными целями,",
            "даруя огонь и божественную кару.",
            "",
            "Время и сомнительные цели притупили",
            "клинок, но его можно восстановить."
        ]
    },
    "empty bottle": {
        "blurb": [
            "Хрупкие сосуды лучше всего подходят",
            "для сбора жидкости из фонтанов",
            "и водяных насосов.",
            "",
            "Начинающему зельевару пригодится",
            "всё, что можно пить, для опытов."
        ]
    },
    "face accessories": {
        "blurb": [
            "Искатели дополняют свой образ",
            "подходящими очками или предметом,",
            "который можно зажать в зубах.",
            "",
            "Эти вещи дают разные преимущества,",
            "но некоторым важнее стиль."
        ]
    },
    "fire and hunting ammo": {
        "blurb": [
            "Некоторые стрелы запоминаются надолго.",
            "",
            "ОГНЕННЫЕ СТРЕЛЫ освещают помещение",
            "и поджигают врагов, а губительные",
            "ОХОТНИЧЬИ СТРЕЛЫ опустошают ряды зверей,",
            "замедляя и отравляя их."
        ]
    },
    "fist weapons": {
        "blurb": [
            "Для тех, кто боится поломки оружия",
            "в самый неподходящий миг. Боевые",
            "рукавицы добавляют каждому удару",
            "кулаком немного убедительности.",
            "Умелый боец внезапным ударом",
            "может оглушить противника."
        ]
    },
    "gungnir": {
        "blurb": [
            "Говорят, это копьё выковали",
            "для богов, чтобы каждый удар",
            "неизменно достигал цели.",
            "",
            "Даже новичок с ГУНГНИРОМ смертельно опасен.",
            "Такое оружие обычно хорошо охраняют."
        ]
    },
    "gyrobot": {
        "blurb": [
            "Поначалу механики придумали",
            "ГИРОБОТА как простую игрушку-спутника.",
            "Со временем он научился выполнять",
            "множество полезных задач.",
            "Умелый механик найдёт своему",
            "питомцу немало применений."
        ]
    },
    "hats & hoods": {
        "blurb": [
            "Многие ремёсла и сообщества узнают",
            "по практичным и стильным уборам.",
            "",
            "ШЛЯПЫ и КАПЮШОНЫ помогают в деле",
            "и говорят всем о вашем занятии."
        ]
    },
    "iron armor": {
        "blurb": [
            "Тяжелее кожи, но защищает владельца",
            "вдвое лучше.",
            "Для быстрого бега в ЖЕЛЕЗЕ нужна сила.",
            "",
            "Когда-то Гамлет славился",
            "богатыми железными рудниками."
        ]
    },
    "khryselakatos": {
        "blurb": [
            "Любимый лук легендарного охотника,",
            "ХРИСЕЛАКАТОС выпускает зачарованные стрелы",
            "со своей нерушимой тетивы.",
            "",
            "По мифам, его владельца лишили",
            "божественности и отправили в изгнание."
        ]
    },
    "leather armor": {
        "blurb": [
            "Лёгкая, дешёвая и распространённая,",
            "КОЖА для большинства искателей",
            "куда лучше полного отсутствия брони.",
            "",
            "Полный кожаный доспех хорошо защищает",
            "от урона более слабых врагов."
        ]
    },
    "lockpick": {
        "blurb": [
            "Умелый механик этими простыми",
            "инструментами вскроет сундук и дверь,",
            "обезвредит стрелковую ловушку",
            "или подстроит пружины самодельной.",
            "",
            "Полезная вещь против опасных устройств."
        ]
    },
    "maces": {
        "blurb": [
            "БУЛАВЫ созданы дробить и крушить",
            "твёрдые цели. Это надёжное оружие",
            "ломает броню и оглушает даже",
            "самых защищённых врагов.",
            "В умелых руках не оставляет",
            "врагу шанса дать сдачи."
        ]
    },
    "mail & lore books": {
        "blurb": [
            "Маги не найдут силы на этих",
            "обычных страницах, но любопытные",
            "искатели охотно читают написанное",
            "в поисках подсказок.",
            "",
            "А ещё бумага хорошо горит в котле."
        ]
    },
    "masks & visors": {
        "blurb": [
            "Одни искатели скрывают под МАСКОЙ",
            "своё лицо, другие выражают себя.",
            "",
            "А кому-то полезные лицевые аксессуары",
            "помогают лучше справляться с делом."
        ]
    },
    "meat, fish, and bread": {
        "blurb": [
            "Сытные порции, любимые голодными",
            "обитателями подземелий. Сильный голод",
            "иногда требует целых двух порций,",
            "чтобы наесться. Только осторожнее:",
            "не стоит переедать."
        ]
    },
    "mining pick": {
        "blurb": [
            "Этими удобными инструментами легко",
            "прорубить короткий путь через землю",
            "или добраться до скрытых сокровищ.",
            "",
            "КИРКИ быстро ломаются, но незаменимы,",
            "если вы заблудились или попали в тупик."
        ]
    },
    "mirrors": {
        "blurb": [
            "Нет доказательств, что зеркала крадут",
            "души. Но, похоже, они отражают",
            "и обычную, и волшебную реальность.",
            "",
            "Порой взглянувший в зеркало узнаёт",
            "о себе больше, чем рассчитывал."
        ]
    },
    "mystic orb": {
        "blurb": [
            "Загадочная сфера, переполненная",
            "волшебной силой.",
            "Подходящий пьедестал позволит",
            "её высвободить. Впрочем, наверняка",
            "кто-нибудь выложит целое состояние",
            "за столь бесценный артефакт."
        ]
    },
    "noisemaker": {
        "blurb": [
            "Простой, но хитроумный пружинный",
            "механизм издаёт завораживающий шум,",
            "который привлекает внимание",
            "ближайших врагов.",
            "Отлично отвлекает противников",
            "и заманивает в засаду."
        ]
    },
    "offensive potions": {
        "blurb": [
            "Многие зелья вредят врагам, порой",
            "с сокрушительным эффектом,",
            "и наносят урон при броске.",
            "",
            "АТАКУЮЩИЕ ЗЕЛЬЯ можно выпить,",
            "но обычно так делают по незнанию."
        ]
    },
    "oracles treads": {
        "blurb": [
            "В древнем мифе странник вошёл",
            "в царство тьмы, скрывавшее",
            "всевозможное зло.",
            "Свидетели писали: он чуял опасность",
            "по колебаниям земли и быстро",
            "покорил это царство."
        ]
    },
    "parashu": {
        "blurb": [
            "Многие называют своё оружие ПАРАШУ,",
            "но один вечный топор можно вернуть",
            "к его легендарной смертоносности.",
            "",
            "Когда-то он служил богам, а ныне",
            "попадается в самых низких местах."
        ]
    },
    "polearms": {
        "blurb": [
            "Длина и баланс древкового оружия",
            "особенно полезны против крупных",
            "и тяжёлых зверей.",
            "",
            "В умелых руках такое оружие",
            "держит врага на расстоянии."
        ]
    },
    "rocks & gems": {
        "blurb": [
            "Любой камень пригодится, если нужно",
            "бросить что-нибудь в ловушку или врага.",
            "",
            "Но самоцветы милы и лавочникам,",
            "и автоматонам — как, впрочем, всем,",
            "кого манит жадность."
        ]
    },
    "sentrybot and magic sentry": {
        "blurb": [
            "С помощью волшебных кристаллов",
            "механики даровали подобие разума",
            "треногам с головами, которые",
            "метают снаряды.",
            "Если не мешать такому стражу",
            "стрелять, урон будет сокрушительным."
        ]
    },
    "sharur": {
        "blurb": [
            "По легенде, некий мудрец переходил",
            "из царства в царство и давал советы.",
            "",
            "На время царству было обеспечено",
            "процветание, но советника",
            "неизменно отправляли в изгнание."
        ]
    },
    "shields": {
        "blurb": [
            "Щит в руках искателя постоянно",
            "даёт защиту, но если поднять его",
            "для блока, защита станет куда лучше.",
            "",
            "Некоторые щиты при блокировании",
            "приносят и другие преимущества."
        ]
    },
    "silver and piercing ammo": {
        "blurb": [
            "Против разных врагов стоит",
            "подбирать разные боеприпасы.",
            "",
            "ПРОБИВНЫЕ СТРЕЛЫ пронзают",
            "крепчайшую броню. Нежить и демоны",
            "больше боятся СЕРЕБРЯНЫХ СТРЕЛ."
        ]
    },
    "skeleton key": {
        "blurb": [
            "Один замочный мастер изобрёл",
            "такой ключ, чтобы любой мог",
            "открывать обычные сундуки и двери.",
            "",
            "Универсальный ключ уступает отмычке",
            "возможностями, но не требует обучения."
        ]
    },
    "slingshot": {
        "blurb": [
            "Простейшее стрелковое оружие —",
            "рогатка — на вид не впечатляет.",
            "",
            "Но когда нужен бой на расстоянии,",
            "метать пули и убегать —",
            "далеко не худший выход."
        ]
    },
    "sphinxs casque": {
        "blurb": [
            "Говорят, странник встретил сфинкса,",
            "задавшего неразрешимую загадку.",
            "",
            "Странник немного подумал и",
            "в ответ задал вопрос, на который",
            "сфинкс не смог ответить."
        ]
    },
    "steel armor": {
        "blurb": [
            "Крепче железа и лишь чуть тяжелее.",
            "Чтобы раздобыть превосходную",
            "СТАЛЬНУЮ броню, нужны удача или деньги.",
            "",
            "Лишь немногие кузнецы умеют ковать СТАЛЬ."
        ]
    },
    "swift and springshot ammo": {
        "blurb": [
            "Превратить врага в подушечку для игл,",
            "пока он не подошёл, —",
            "цель многих лучников.",
            "Лёгкие СТРЕМИТЕЛЬНЫЕ СТРЕЛЫ быстрее",
            "заряжаются, а ОТТАЛКИВАЮЩИЕ СТРЕЛЫ",
            "механики готовят для мощного отбрасывания."
        ]
    },
    "swords": {
        "blurb": [
            "МЕЧИ смертельны против мягких целей:",
            "их жуткое призвание — резать плоть.",
            "Крепкая шкура может отразить удар,",
