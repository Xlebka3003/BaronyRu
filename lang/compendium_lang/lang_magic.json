{
    "blessings": {
        "blurb": [
            "На войне и в отрядах искателей приключений",
            "высоко ценят дарующих БЛАГОСЛОВЕНИЯ.",
            "Они помогают как самому чудотворцу,",
            "так и спутникам и союзникам рядом.",
            "",
            "Некоторые благословения действуют долго."
        ]
    },
    "contravention": {
        "blurb": [
            "Почти вся магия нарушает законы реальности.",
            "Но искусство ИСКАЖЕНИЯ позволяет колдуну",
            "изменять то, как эти законы действуют",
            "на него самого.",
            "Это постоянно расходует магическую силу,",
            "но действие можно прекратить по желанию."
        ]
    },
    "daimonia": {
        "blurb": [
            "МАГИЯ ДУХОВ позволяет с помощью чар",
            "обращаться к воле духов, принуждая их",
            "влиять на мир и преображать его.",
            "Цивилизованное общество отвергает её,",
            "но некоторые мистики считают свой дух",
            "неполным без этого общения."
        ]
    },
    "divinations": {
        "blurb": [
            "ПРОРИЦАНИЯ открывают тайные знания",
            "и сведения, которые иным путём",
            "порой невозможно получить.",
            "",
            "Практикующие чудотворцы утверждают:",
            "знание — сила."
        ]
    },
    "enchanted amulets": {
        "blurb": [
            "АМУЛЕТЫ помогают владельцу при опасности:",
            "часто несколько раз защищают от вреда,",
            "вмешиваясь в нужный момент, пока",
            "не иссякнет их магическая сила.",
            "У некоторых амулетов цель противоположная.",
            "Лучше оценить амулет до того, как надеть."
        ]
    },
    "enchanted feather": {
        "blurb": [
            "ЗАЧАРОВАННОЕ ПЕРО расходует свой заряд,",
            "восстанавливая книги заклинаний или",
            "нанося волшебные слова на чистый свиток.",
            "Лишь знающий волшебные слова способен",
            "начертать их с желаемым результатом.",
            "Разряженные перья можно зарядить снова."
        ]
    },
    "enchanted rings": {
        "blurb": [
            "Искатели приключений ценят волшебные",
            "КОЛЬЦА за пассивные магические эффекты.",
            "Одни дают скромную пользу,",
            "другие помогают лишь в особых случаях,",
            "а третьи невероятно могущественны.",
            "Волшебные кольца способны изменить мир."
        ]
    },
    "evocation": {
        "blurb": [
            "С помощью ВОПЛОЩЕНИЯ колдуны создают",
            "энергию и материю силой разума.",
            "В основном искатели приключений",
            "используют его для обстрела врагов.",
            "Многие снаряды оставляют долгий эффект,",
            "который продолжает вредить цели."
        ]
    },
    "impeturia": {
        "blurb": [
            "Практикуя ВЛАСТЬ НАД ВЕЩАМИ, мистики",
            "взывают к духу предмета, который хотят",
            "изменить, и заставляют его сменить",
            "состояние. Колдуны пытаются добиться",
            "того же с помощью кинеза, но пока",
            "безуспешно."
        ]
    },
    "kinesis": {
        "blurb": [
            "КИНЕЗ позволяет колдунам двигать вещи",
            "силой разума. Улучшая точность",
            "и управляемость, они случайно сделали",
            "и другие открытия. Но тонкие манипуляции",
            "по-прежнему даются с трудом."
        ]
    },
    "magicstaffs": {
        "blurb": [
            "Это оружие позволяет любому искателю",
            "приключений метать чары без дара к магии.",
            "",
            "По цвету посоха можно предположить,",
            "какое заклинание он содержит.",
            "Исчерпав заряд, посох всегда ломается."
        ]
    },
    "meditations": {
        "blurb": [
            "Простая МЕДИТАЦИЯ обычно становится",
            "первым знакомством мага с чудотворством.",
            "",
            "Для поддержания этих чар нужна",
            "сосредоточенность. Они влияют лишь",
            "на мага; снять их можно по желанию."
        ]
    },
    "miraculous feats": {
        "blurb": [
            "Первые известные чудотворцы древности",
            "творили ЧУДЕСА. При чтении таких чар",
            "сразу происходит одно удивительное",
            "действие.",
            "Согласно учению, эти силы дарует",
            "единение с великим предназначением."
        ]
    },
    "psianimus": {
        "blurb": [
            "Самое распространённое искусство",
            "мистиков — МАГИЯ РАЗУМА. Она чарами",
            "меняет разум живой",
            "или неживой цели.",
            "Эффекты обычно временны, иначе",
            "репутация у неё могла бы быть иной."
        ]
    },
    "sarkomancy": {
        "blurb": [
            "Церковь считает МАГИЮ ПЛОТИ тёмным",
            "и запретным искусством. Эти чары",
            "меняют тело, обычно против воли",
            "того, на кого они направлены.",
            "Применение таких чар во благо своему",
            "телу якобы не более чем слухи."
        ]
    },
    "scrolls": {
        "blurb": [
            "Любой искатель приключений может",
            "вызвать чары из свитка, но тот сразу",
            "исчезает после использования.",
            "Некоторые чары есть только на свитках.",
            "Чистые свитки можно заполнить позднее,",
            "имея нужные инструменты и знания."
        ]
    },
    "temulturgy": {
        "blurb": [
            "Порой нужна магия, которая не просто",
            "сталкивает одну силу с другой.",
            "Школа РАЗРУШЕНИЯ специализируется",
            "на нарушении структуры предметов.",
            "Применять её к живым целям колдуны",
            "пока так и не научились."
        ]
    },
    "scepter": {
        "blurb": [
            "Невероятно разрушительный СКИПЕТР",
            "АРХОНТА питается воспоминаниями,",
            "которыми жертвует его владелец.",
            "Владельцы обычно заявляют, что скипетр",
            "принадлежит им по праву рождения.",
            "Другие не помнят, откуда его взяли."
        ]
    },
    "source_foci": {
        "blurb": [
            "Колдуны часто носят чистые проявления",
            "стихий в виде СТИХИЙНЫХ СРЕДОТОЧИЙ,",
            "усиливая связь с магическими энергиями.",
            "Каждое светится и служит проводником",
            "для быстрого воплощения, когда нужно",
            "разобраться с угрозой."
        ]
    },
    "holy_symbols": {
        "blurb": [
            "Верные чудотворцы несут СВЯЩЕННЫЕ",
            "СИМВОЛЫ, изгоняя тьму на своём пути.",
            "Молитва с таким символом в руке",
            "благословляет любую согласную душу,",
            "когда заканчивается волшебное песнопение.",
            "Чем дольше молитва, тем сильнее эффект."
        ]
    },
    "dark_icons": {
        "blurb": [
            "Мистики используют ТЁМНЫЕ ИКОНЫ,",
            "чтобы направлять свои магические",
            "искусства на проклятие врагов.",
            "У каждой иконы свой пагубный эффект:",
            "заклинатель вызывает его шёпотом,",
            "мешая врагам на расстоянии."
        ]
    },
    "instruments": {
        "blurb": [
            "МУЗЫКАЛЬНЫЕ ИНСТРУМЕНТЫ сами по себе",
            "обычны, но проводят магию духа",
            "музыканта, воодушевляя друзей,",
            "которые слышат музыку.",
            "Если играть с усердием и заботой,",
            "песни ещё некоторое время звучат в воздухе."
        ]
    },
    "jewels": {
        "blurb": [
            "ДРАГОЦЕННЫЕ КАМНИ ценны и желанны",
            "для большинства разумных существ.",
            "Это отличная плата верным спутникам.",
            "Многие ювелиры оправляют самоцветы",
            "в золото, придавая им ещё больше",
            "красоты и ценности."
        ]
    }
}
