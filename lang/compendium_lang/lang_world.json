3,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"sokoban":{"blurb":["Вошедшим кажется, будто за ними","наблюдают и оценивают, словно","они проходят испытание.","Циники видят в этом проделку","жестоких богов, которым нравится","смотреть, как смертные мрут от голода."],"details":["СОКРОВИЩА ТАЙНОГО УРОВНЯ:","- Наручи джинна","- Целое состояние золотом","","Чтобы пройти испытание, нужно убрать","все валуны из комнаты с помощью","кольца мощи или зелья силы.","","Сбросьте все валуны в ямы — и победа","ваша. Не загоняйте их в углы:","валуны можно только толкать,","а тянуть назад нельзя!","","Разрушение валунов ради решения","головоломки уменьшает награду."],"details_line_highlights":[{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"spike trap":{"blurb":["Создатель этих жестоких устройств","был либо очень зол, либо очень","боялся чего-то огромного.","","Их легко заметить и обойти...","если есть время смотреть под ноги."],"details":["Шипы наносят 50 урона независимо","от брони и стойкости жертвы.","Многие срабатывают при движении","над ними, даже во время левитации.","","Обезвредьте ловушку, бросив на неё","ненужную вещь. Обычно шипы","не взводятся вновь, пока предмет","не уберут. Это поможет спутникам","выжить во время блужданий.","","Шипы опасны лишь в момент","выдвижения снизу. Между поднятыми","шипами можно пройти: так у вас будет","больше времени на некоторые манёвры!"],"details_line_highlights":[]},"summoning trap":{"blurb":["Напитанная тайными ритуалами","ЛОВУШКА ПРИЗЫВА мгновенно превращает","пустую комнату в смертельное поле боя.","","Будьте осторожны рядом с символами:","призвать врагов можно разными путями."],"details":["Знак на полу выдаёт эту ловушку.","Призыв может вызвать","приближение, поворот рычага","или взятая с пола","жертва-подношение.","","Грохот сопровождает появление","перенесённых демонических духов.","","Ретивые искатели приключений любят","дразнить такие ловушки, вызывая","новых отродий ада себе на расправу.","Но это рискованно: почти невозможно","узнать, какая битва вас ожидает."],"details_line_highlights":[]},"swamps":{"blurb":["Густую поросль здесь вырубили","ради расширения шахт Гамлета,","но влаголюбивые растения отросли.","","Увы, известно, что их употребление","в пищу вызывает помешательство."],"details":["ОБИТАТЕЛИ:","Пауки, гоблины, слизи, упыри, тролли","","НОВАЯ ЛОВУШКА:","Ловушка со стрелами","","На болотах появляются новые враги,","бьющие издали. Поможет Скрытность!","","Берегитесь гоблинов с посохами.","Лучшее средство — отражение магии.","Иначе нападайте из засады или издали,","чтобы успевать уклоняться от снарядов.","Вода поможет потушить пламя."],"details_line_highlights":[{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{},{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"temple":{"blurb":["Злой бог услышал молитвы болотных","гоблинов и даровал им место","на поверхности для кровавых жертв.","К этому ХРАМУ проложен смертельно","опасный путь для поклонения."],"details":["СОКРОВИЩА ТАЙНОГО УРОВНЯ:","- 4 зелья силы","- Груда золотых монет","- Несколько сундуков с сокровищами","","Серебряный ключ открывает","тайные комнаты с сокровищами.","Ловушки Храма могут перекрыть","доступ к тайникам из-за неосторожности","исследователей или освобождения узников.","","В Храме стоит сперва составить план,","чтобы избежать досадных ошибок."],"details_line_highlights":[{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"the church":{"blurb":["Служители ЦЕРКВИ мирно блюдут","культуру, пока дела не выйдут из рук.","","Тогда клирики, монахи и пономари","переходят к действию, чтобы","исправить несправедливость."],"details":["Члены церкви видят в событиях мира","единый великий замысел и посвящают","жизнь попыткам понять","и поддержать его.","","Без особых амбиций служители обычно","сторонятся общественных дел. Но ни","одна организация не бывает столь","едина, как церковь, когда история","отклоняется от своего предназначения.","","Её посланники обычно практичны:","ценят как силу, так и магию, если те","дают простую и ощутимую пользу."],"details_line_highlights":[]},"transition floor":{"blurb":["По мере углубления шахт каждый","слой подземелий открывали впервые.","","Между слоями лежали природные","расщелины: через них строили мосты,","и на это нередко уходили недели."],"details":["Странный покой переходных этажей","действует на искателей приключений:","голод здесь нарастает гораздо","медленнее обычного.","Идеальное место для передышки.","","Но будьте начеку: вместо сундуков","и здесь могут оказаться мимики.","","На переходном этаже между","шахтами и болотами скрыт","портал в Подземный мир.","Если хотите рискнуть, понадобится","какой-нибудь способ копать."],"details_line_highlights":[]},"underworld":{"blurb":["В эти катакомбы сперва попадают","души недавно умерших.","","В зависимости от прожитой жизни","обитатели Подземного мира могут","сослать их ещё ниже, в Ад."],"details":["ОБИТАТЕЛИ:","Скелеты, слизи, упыри, бесы,","тени","","СОКРОВИЩА ТАЙНОГО УРОВНЯ:","- Хриселакатос (ур. 7)","","В Подземный мир ведут два тайных","входа: на этажах 5 и 18.","В обоих случаях искателей,","нашедших люк на второй этаж","Подземного мира, ждёт","смертоносная награда.","","Учтите: многие враги бьют через ямы."],"details_line_highlights":[{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{},{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"cauldron":{"blurb":["В крепком КОТЛЕ удобно варить","зелья или готовить горячий обед.","Он пригодится","в любом хозяйстве.","Жаль, слишком тяжёлый,","чтобы унести с собой!"],"details":["Котёл позволяет любому искателю","приключений, независимо от знаний","алхимии, освободить место в рюкзаке.","Готовка превращает разную еду","в пайки, а сливание объединяет","зелья в одной ёмкости.","","Из зелий и пайков можно создавать","приправленную еду, которая","улучшает характеристики.","","При навыке алхимии 80 и выше","можно готовить свежие пайки","без риска несварения."],"details_line_highlights":[]},"workbench":{"blurb":["ВЕРСТАК не так удобен, как переносной","набор механика, но содержит те же","инструменты, позволяя находчивым","искателям создавать полезные вещи","для преодоления будущих преград."],"details":["Прочный стол и надёжные инструменты","не изнашиваются. Поэтому верстак","полезен, даже если у вас","есть набор механика.","","Время от времени мастерить полезно","многим искателям, особенно чтобы","всегда иметь под рукой пустые","бутылки, отмычки или ловушки.","","Только механик начинает с набором,","но навыком владеют и другие классы.","Верстак позволяет им тоже","пользоваться инструментами."],"details_line_highlights":[]},"button":{"blurb":["Подобно рычагу, КНОПКУ можно нажать","вручную или поразить снарядом","издалека, чтобы привести в действие","механизмы подземелья.","Некоторые со временем отжимаются."],"details":["О простой кнопке подземелья","особо и рассказывать нечего.","","Зодчие порой предпочитают кнопки","рычагам: им не нужно место на полу,","и их проще спрятать на стене","там, где посторонним","не положено ими пользоваться.","","Остерегайтесь отжимающихся кнопок:","обычно это признак головоломки","или ловушки для неосторожных."],"details_line_highlights":[]},"wall locks":{"blurb":["НАСТЕННЫЕ ЗАМКИ обычно запирают","непробиваемые железные двери.","Нужен ключ из того же материала.","Замки управляют и иными устройствами,","а иногда позволяют включать","и отключать механизм поворотом ключа."],"details":["За железной дверью обычно хранят","ценные вещи или золото:","ключи часто обменивают на сокровища.","Сначала стоит заглянуть","в удобное окошко железной двери","и оценить награду за ней —","если, конечно, хватает роста.","","Железные, бронзовые и часть серебряных","замков можно вскрыть при достаточной","Механике или универсальным ключом.","Но чем глубже подземелье","и чем ценнее сокровища,","тем надёжнее их охрана."],"details_line_highlights":[]},"arcane boulder":{"blurb":["Валуны и без того смертельно опасны,","но скопления кристаллов наделяют","их ещё и губительной магией.","","Магические валуны катятся быстрее","и мощнее, нарушая законы физики."],"details":["Самая смертоносная ловушка с валуном.","Кто дожил до встречи с этими","грозными шарами, уже должен","уметь от них уклоняться.","","Берегитесь: они падают и катятся","гораздо быстрее, беспрепятственно","пересекают жидкости и ямы,","а их сокрушительную силу","усиливает магический взрыв.","","Владеющие Кинетическим толчком","или Телекинезом могут обратить эти","волшебные свойства себе на пользу."],"details_line_highlights":[]},"assist shrine":{"blurb":["СВЯТИЛИЩЕ ПОМОЩИ не всегда стояло","у входа в шахты. По словам Церкви,","Вечные установили его, чтобы:","''Дать храбрым победить Херкса, снять","проклятие; дать надежду отчаявшимся.''","(к добру ли, к худу ли)"],"details":["Беря вещи из святилища помощи,","отряд должен помнить: его оценят","по общему объёму","полученной помощи.","В отрядах с разным опытом так","сильные искатели могут сохранить","всю сложность испытания, а новички —","заметно облегчить свою долю.","","Даже начинающий герой-одиночка","может совершить великие подвиги,","взяв побольше помощи.","","Стыдиться тут нечего!"],"details_line_highlights":[]}}