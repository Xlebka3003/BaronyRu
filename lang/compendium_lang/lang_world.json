а."],"details_line_highlights":[]},"crystal caves":{"blurb":["Богатые залежи редчайших кристаллов","открыли совсем недавно, но","архимагистры Гильдии магов","поспешили опечатать пещеры.","Ради безопасности Гамлета, конечно."],"details":["ОБИТАТЕЛИ:","Кобольды, скарабеи, инсектоиды,","автоматоны, инкубы, кристальные големы,","кокатрисы","","НОВАЯ ЛОВУШКА:","Потолочная ловушка","","Здешние кристаллы наделяют","многих обитателей силой,","недостижимой в природе.","","Даже уверенным в себе искателям","после руин стоит проявить","больше осторожности с новыми врагами."],"details_line_highlights":[{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}},{},{"color":{"r":198,"g":190,"b":179,"a":255}},{"color":{"r":157,"g":129,"b":93,"a":255}}]},"daedalus":{"blurb":["Связанные с минотавром СВЯТИЛИЩА ДЕДАЛА","словно всегда оказываются рядом,","когда он выходит на охоту.","","Находчивый искатель коснётся их","и обретёт надежду быстро спастись."],"details":["При касании святилище поворачивается","к главному выходу, направляя","туда луч прорицания.","Он также открывает карту","между святилищем и выходом!","","Если коснуться его в последние 30 секунд","до прихода минотавра, святилище","поможет беглецу дополнительным","благословением скорости.","","Отрядам проще решиться","разделиться там, где охотится","минотавр, зная, что","Дедалу воздают почести","и он может им помочь."],"details_line_highlights":[]},"door":{"blurb":["Открывается, закрывается","и порой бывает заперта!","","В отличие от решёток, ДВЕРИ можно","взломать или выбить. Чудовища бьют","двери, если ума открыть их не хватает."],"details":["Заклинание запирания не даёт","чудовищам просто открыть дверь,","но выбить её большинству","всё равно несложно.","Даже запертая дверь ненадёжно","защищает от чудовищ.","","Взлом замка обычно быстрее,","чем удары по двери, и заодно","развивает навык механики.","","Топоры и 